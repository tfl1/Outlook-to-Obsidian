<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6e462733-e29a-4781-ba71-e74b3ac981f3</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Tom Loiacono</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Outlook to Obsidian (Test)"/>
  <Description DefaultValue="Connection test: lists folders in your Obsidian vault via the Local REST API plugin."/>
  <IconUrl DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/tfl1/Outlook-to-Obsidian"/>
  <AppDomains>
    <AppDomain>https://tfl1.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="o2oGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="o2oOpenPane">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/assets/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/assets/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://tfl1.github.io/Outlook-to-Obsidian/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Obsidian"/>
        <bt:String id="ButtonLabel" DefaultValue="To Obsidian (Test)"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTip" DefaultValue="Open the Outlook-to-Obsidian connection test pane."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
